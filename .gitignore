# Build output — Netlify regenerates this from source on every deploy
dist/

# macOS
.DS_Store

# Editor / tooling
node_modules/
*.log
.env
.env.*

# Generated bundle for AI review
SHATTERPROMPTS-ALL-CODE.txt

# Generated premium prompt content (large, built up batch by batch)
content/premium/*.json
content/free/*.json

# Raw content-generation source material (docx drafts, Reel scripts, photo
# slides, SFX, business analysis) — not code, not deployed, kept alongside
# the project for convenience but never committed.
content-source-materials/

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
